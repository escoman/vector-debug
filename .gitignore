# Build artifacts
build/*

# Track workspace presets (generated by debugger, committed to repo)
!build/workspaces/
!build/workspaces/*.ini
!build/make_release.sh

# Third-party libraries (submodules or manually added)
thirdparty/

# IDE files
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Workspace runtime files (auto-generated, machine-specific)
build/workspaces/current.txt

# App config (auto-generated, machine-specific)
build/config.ini
